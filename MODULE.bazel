module(name = "cpp_rust_concurrent_structures", version = "0.1.0")

bazel_dep(name = "rules_cc", version = "0.2.26")

bazel_dep(name = "boost.asio", version = "1.90.0.bcr.1")

bazel_dep(name = "boost.lockfree", version = "1.90.0.bcr.1")

bazel_dep(name = "google_benchmark", version = "1.9.5")

bazel_dep(name = "googletest", version = "1.17.0")

bazel_dep(name = "cli11", version = "2.7.2")

bazel_dep(name = "quill", version = "13.1.0")

bazel_dep(name = "fmt", version = "11.2.0")

bazel_dep(name = "ftxui", version = "7.0.3")

cc_configure = use_extension("@rules_cc//cc:extensions.bzl", "cc_configure_extension")

use_repo(cc_configure, "local_config_cc")

bazel_dep(name = "rules_rust", version = "0.75.0")

rust = use_extension("@rules_rust//rust:extensions.bzl", "rust")

rust.toolchain(edition = "2021", versions = ["1.85.1"])

use_repo(rust, "rust_toolchains")

register_toolchains("@rust_toolchains//:all")

crate = use_extension("@rules_rust//crate_universe:extensions.bzl", "crate")

crate.spec(package = "crossbeam-queue", version = "0.3.14")

crate.spec(package = "crossbeam-skiplist", version = "0.1.3")

crate.spec(package = "scc", version = "3.8.8")

crate.from_specs(name = "crates")

use_repo(crate, "crates")

http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

http_archive(
    name = "libcds",
    build_file = "//third_party/libcds:libcds.BUILD.bazel",
    sha256 = "f090380ecd6b63a3c2b2f0bdb27260de2ccb22486ef7f47cc1175b70c6e4e388",
    strip_prefix = "libcds-2.3.3",
    urls = ["https://github.com/khizmax/libcds/archive/refs/tags/v2.3.3.tar.gz"]
)