load("@rules_cc//cc:cc_binary.bzl", "cc_binary")

package(default_visibility = ["//visibility:public"])

_BENCH = "//cpp/benchmarks/common:bench"

_BENCHMARKS = [
    "mutex",
    "rwlock",
    "once",
    "condvar",
    "barrier",
    "thread",
    "atomic_ptr",
    "atomic_flag",
    "coroutine"
]

[
    cc_binary(
        name = "bench_" + name,
        srcs = ["bench_" + name + ".cpp"],
        deps = [_BENCH]
    )
    for name in _BENCHMARKS
]
